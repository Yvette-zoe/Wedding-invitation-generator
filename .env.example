# 设为 false 时走真实后端；demo 默认使用 mock
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api

# 视觉解析（Qwen3-VL，OpenAI 兼容接口）
# 推荐用阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 硅基流动则用：https://api.siliconflow.cn/v1/chat/completions ，模型 Qwen/Qwen3-VL-32B-Instruct
VITE_VL_API_KEY=
VITE_VL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_VL_MODEL=qwen3-vl-plus

# 兼容旧变量名，未配 VITE_VL_* 时会回退到这里
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_DEEPSEEK_MODEL=qwen3-vl-plus
